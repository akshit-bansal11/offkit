{
  "name": "open-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop utilities for images, video, audio, PDFs, SVG, colors and text.",
  "author": "Akshit Bansal",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "node scripts/copy-vendor.mjs && node scripts/next-desktop.mjs dev",
    "build": "next build",
    "build:desktop": "node scripts/copy-vendor.mjs && node scripts/next-desktop.mjs build",
    "start": "next start",
    "app": "electron .",
    "dist": "npm run build:desktop && electron-builder --win --publish never",
    "lint": "eslint",
    "check": "biome check --write . && eslint --fix && stylelint \"src/**/*.css\" --fix && tsc --noEmit",
    "check:ci": "biome ci . && eslint && stylelint \"src/**/*.css\" && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "npm run test:e2e:desktop && npm run test:e2e:web",
    "test:e2e:desktop": "npm run build:desktop && playwright test -c playwright.desktop.config.ts",
    "test:e2e:packaged": "playwright test -c playwright.desktop.config.ts",
    "test:e2e:web": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imagemagick/magick-wasm": "^0.0.39",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/dompurify": "^3.0.5",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "dompurify": "^3.3.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.6",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.8",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.19",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
