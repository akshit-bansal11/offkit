{
  "name": "offkit",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop utilities for images, video, audio, PDFs, SVG, colors and text.",
  "author": "Akshit Bansal",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check": "biome check --write . && eslint --fix && stylelint \"src/**/*.css\" --fix && tsc --noEmit",
    "check:ci": "biome ci . && eslint && stylelint \"src/**/*.css\" && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e:web": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imagemagick/magick-wasm": "^0.0.44",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/dompurify": "^3.2.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "dompurify": "^3.3.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.8",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.19",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7"
  }
}
