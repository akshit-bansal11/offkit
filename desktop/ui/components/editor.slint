// Editor-style building blocks for tools that work on text rather than file lists (Text,
// Colors, CSS, SVG, Dev). The layout they share: a toolbar row of mode controls and Open… on
// top, then Panes side by side (input left, output or preview right), each a PaneHeader, whose
// actions (Copy, Save…) sit on its right, over its body. See tools/base64.slint.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppIcons } from "../icons/icons.slint";
import { Button, ButtonKind, DropOutline, FocusRing } from "controls.slint";

// Multi-line text, editable or read-only, with a right-click Cut/Copy/Paste menu. Scrolls to
// keep the caret in view. Monospace by default; `drop-hover` outlines it as a drop target.
// Typing or pasting past `max-characters` is undone, with a note pointing to Open…: longer text
// makes every keystroke lag (1.3 MB took about 11 s to lay out in a debug build).
export component TextPane {
    in-out property <string> text <=> input.text;
    in property <bool> read-only <=> input.read-only;
    in property <string> placeholder;
    // The accessible name, usually the pane's header ("Text", "Base64").
    in property <string> label;
    in property <bool> mono: true;
    in property <bool> drop-hover;
    out property <bool> has-focus: input.has-focus;
    // The selection as UTF-8 byte offsets, for tools that edit around it (the Markdown toolbar).
    out property <int> selection-anchor: input.anchor-position-byte-offset;
    out property <int> selection-cursor: input.cursor-position-byte-offset;
    public function select(anchor: int, cursor: int) { input.focus(); input.set-selection-offsets(anchor, cursor); }
    callback edited(string);

    // The caret's line, for scrolling it into view.
    private property <length> line-height: Theme.size-body * 1.5;
    // One limit for every pane, kept here so tools can't drift apart.
    private property <int> max-characters: 100000;
    private property <bool> refused;

    min-height: 120px;
    min-width: Theme.pane-min-width;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    accessible-read-only: root.read-only;

    DropOutline {
        border-radius: Theme.radius-group;
        background: Theme.bg-surface-raised;
        drop-hover: root.drop-hover;
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Cut";
                enabled: !root.read-only;
                activated => { input.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: root.text != "";
                activated => { input.copy(); }
            }
            MenuItem {
                title: "Paste";
                enabled: !root.read-only;
                activated => { input.paste(); }
            }
            MenuItem {
                title: "Select All";
                enabled: root.text != "";
                activated => { input.select-all(); }
            }
        }

        scroll := ScrollView {
            x: Theme.space-3;
            y: Theme.space-2;
            width: parent.width - Theme.space-3 - Theme.space-1;
            height: parent.height - 2 * Theme.space-2;
            content-width: self.visible-width;
            content-height: max(self.visible-height, input.preferred-height);

            input := TextInput {
                single-line: false;
                wrap: word-wrap;
                color: Theme.text-primary;
                font-size: Theme.size-body;
                font-family: root.mono ? Theme.font-family-mono : Theme.font-family;
                selection-background-color: Theme.selection-fill;
                selection-foreground-color: Theme.text-primary;
                page-height: scroll.visible-height;
                accessible-role: none;
                edited => {
                    if (self.text.character-count > root.max-characters) {
                        self.undo();
                        root.refused = true;
                    } else {
                        root.refused = false;
                        root.edited(self.text);
                    }
                }
                cursor-position-changed(pos) => {
                    if (pos.y + scroll.content-y < 0) {
                        scroll.content-y = -pos.y;
                    } else if (pos.y + root.line-height + scroll.content-y > scroll.visible-height) {
                        scroll.content-y = min(0, scroll.visible-height - pos.y - root.line-height);
                    }
                }
            }
        }
    }

    Text {
        x: scroll.x;
        y: scroll.y;
        width: scroll.width;
        text: root.text == "" ? root.placeholder : "";
        color: Theme.text-secondary;
        font-size: Theme.size-body;
        font-family: input.font-family;
        wrap: word-wrap;
        vertical-alignment: top;
        accessible-role: none;
    }

    if root.refused: Rectangle {
        x: Theme.space-2;
        y: parent.height - self.height - Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        height: refused-note.preferred-height + 2 * Theme.space-2;
        border-radius: Theme.radius-control;
        background: Theme.bg-grouped;

        refused-note := Text {
            x: Theme.space-2;
            width: parent.width - 2 * Theme.space-2;
            text: "That was longer than 100,000 characters, so it wasn't added. Use Open… for large text.";
            color: Theme.text-primary;
            font-size: Theme.size-callout;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    Timer {
        interval: 6s;
        running: root.refused;
        triggered => { root.refused = false; }
    }

    FocusRing {
        has-focus: input.has-focus;
        radius: Theme.radius-group;
    }
}

// One column of the side-by-side layout: a PaneHeader over its body. Every Pane starts from the
// same size and grows alike, so columns split the width evenly whatever their headers hold.
export component Pane inherits VerticalLayout {
    spacing: Theme.space-2;
    horizontal-stretch: 1;
    min-width: Theme.pane-min-width;
    preferred-width: Theme.pane-min-width;
}

// A pane's title on the left, its actions (the children) on the right.
export component PaneHeader inherits HorizontalLayout {
    in property <string> title;

    spacing: Theme.space-2;
    min-height: Theme.control-height;

    Text {
        text: root.title;
        color: Theme.text-secondary;
        font-size: Theme.size-callout;
        font-weight: Theme.weight-medium;
        vertical-alignment: center;
        horizontal-stretch: 1;
        accessible-role: none;
    }

    @children
}

// Copy that confirms itself: reads "Copied" with a check for a moment when `copy` returns true.
// Rust does the copying (src/clipboard.rs) and returns false, after showing why, if it failed.
export component CopyButton {
    in property <bool> enabled: true;
    in property <string> text: "Copy";
    callback copy() -> bool;

    private property <bool> copied;

    min-width: button.min-width;
    min-height: button.min-height;

    button := Button {
        width: 100%;
        height: 100%;
        text: root.copied ? "Copied" : root.text;
        icon: root.copied ? AppIcons.check : AppIcons.copy;
        kind: ButtonKind.plain;
        enabled: root.enabled;
        clicked => { root.copied = root.copy(); }
    }

    Timer {
        interval: 1600ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
}

export enum NoticeTone { info, error }

// A line under a pane: an error (invalid input, a failed save) or a neutral note ("Binary
// data · 1.2 MB"). Errors carry an icon as well as the colour. Show it with `if`: a hidden
// element still takes its space in a layout.
export component Notice inherits HorizontalLayout {
    in property <string> text;
    in property <NoticeTone> tone: NoticeTone.info;

    spacing: Theme.space-1;

    if root.tone == NoticeTone.error: Image {
        source: AppIcons.alert;
        colorize: Theme.danger;
        width: Theme.icon-size-small;
        height: Theme.icon-size-small;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: root.text;
        color: root.tone == NoticeTone.error ? Theme.danger : Theme.text-secondary;
        font-size: Theme.size-callout;
        vertical-alignment: center;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}
