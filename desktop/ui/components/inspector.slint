// Inspector building blocks, in the grouped-list idiom of iOS Settings: a section title over a
// rounded card of rows. Mark the first row of a card with `first: true`; later rows draw the
// inset separator above themselves. `Inspector` is the right-hand panel of a file tool, with
// the sections scrolling above one primary action.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppIcons } from "../icons/icons.slint";
import { Button, ButtonKind, IconButton } from "controls.slint";

export component InspectorSection {
    in property <string> title;
    in property <string> footnote;

    VerticalLayout {
        spacing: Theme.space-2;

        if root.title != "": HorizontalLayout {
            padding-left: Theme.space-3;

            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: Theme.size-footnote;
                font-weight: Theme.weight-semibold;
                accessible-role: none;
            }
        }

        Rectangle {
            border-radius: Theme.radius-group;
            background: Theme.bg-surface-raised;
            border-width: 1px;
            border-color: Theme.separator;

            VerticalLayout {
                @children
            }
        }

        // A VerticalLayout, not a HorizontalLayout: as the root of an `if` it passes its width,
        // less padding, to the wrapped text, so the text is measured at its real width. Under a
        // HorizontalLayout it was measured as one line and the next section drew over it.
        if root.footnote != "": VerticalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;

            Text {
                text: root.footnote;
                color: Theme.text-secondary;
                font-size: Theme.size-footnote;
                wrap: word-wrap;
            }
        }
    }
}

// One row: label (and optional detail line) on the left, the control on the right.
export component InspectorRow {
    in property <string> label;
    in property <string> detail;
    in property <bool> first;

    min-height: root.detail == "" ? 40px : 48px;

    if !root.first: Rectangle {
        x: Theme.space-3;
        y: 0;
        width: parent.width - Theme.space-3;
        height: 1px;
        background: Theme.separator;
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: Theme.size-body;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.text-secondary;
                font-size: Theme.size-footnote;
                overflow: elide;
            }
        }

        HorizontalLayout {
            alignment: end;
            padding-top: Theme.space-1;
            padding-bottom: Theme.space-1;
            @children
        }
    }
}

// The right-hand panel of a file tool: its sections (the children) scroll; the primary action
// stays at the bottom, swapped for Stop while a batch runs. Give it `width: Theme.inspector-width`.
export component Inspector inherits Rectangle {
    in property <string> action-text; // "Convert All"
    in property <string> stop-text: "Stop All";
    in property <bool> can-run;
    in property <bool> running;
    // Why the action is unavailable, shown above it; empty when it isn't.
    in property <string> note;
    callback run();
    callback stop();

    background: Theme.bg-grouped;

    // Hairline between the file list and the inspector.
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.separator;
    }

    VerticalLayout {
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-5;
                alignment: start;

                @children
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        VerticalLayout {
            padding: Theme.space-4;
            spacing: Theme.space-2;

            if root.note != "": Text {
                text: root.note;
                color: Theme.text-secondary;
                font-size: Theme.size-footnote;
                wrap: word-wrap;
            }
            if !root.running: Button {
                text: root.action-text;
                kind: ButtonKind.primary;
                enabled: root.can-run;
                height: Theme.control-height-large;
                clicked => { root.run(); }
            }
            if root.running: Button {
                text: root.stop-text;
                kind: ButtonKind.secondary;
                height: Theme.control-height-large;
                clicked => { root.stop(); }
            }
        }
    }
}

// "Save to": next to the source files, or a chosen folder (Rust: `FileQueue::out_dir_label`).
export component OutputFolderSection inherits InspectorSection {
    in property <string> folder; // "Same as original" or the folder's name
    in property <bool> custom;
    in property <string> reset-label: "Save next to the source files";
    callback choose();
    callback reset();

    title: "Save to";

    InspectorRow {
        label: root.folder;
        first: true;

        if root.custom: IconButton {
            icon: AppIcons.close;
            label: root.reset-label;
            clicked => { root.reset(); }
        }
        Button {
            text: "Choose…";
            kind: ButtonKind.plain;
            clicked => { root.choose(); }
        }
    }
}
