// Palette Library: the website's 37 palettes, grouped by how many colours they hold, in a grid
// that reflows with the window. Click a colour to copy its hex; copy a whole palette as JSON or
// CSS custom properties. State lives in the `PaletteLibrary` global, driven by
// src/tools/palette_library.rs.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppIcons } from "../icons/icons.slint";
import { FocusRing, SearchField } from "../components/controls.slint";
import { CopyButton, Notice, NoticeTone } from "../components/editor.slint";

export struct LibrarySwatch {
    color: color,
    hex: string,
    // The label reads in white on this colour, rather than black.
    light-ink: bool,
}

export struct PaletteCard {
    index: int,
    name: string,
    swatches: [LibrarySwatch],
}

export struct PaletteSection {
    title: string,
    cards: [PaletteCard],
}

export global PaletteLibrary {
    in property <[PaletteSection]> sections;
    // "No palettes match “x”." while the search finds nothing.
    in property <string> empty-text;
    in property <string> error;

    callback search(string);
    callback copy-color(string) -> bool;
    callback copy-json(int) -> bool;
    callback copy-css(int) -> bool;
}

// One colour of a palette: a button that copies its hex, which it shows.
component SwatchButton inherits Rectangle {
    in property <LibrarySwatch> swatch;
    in property <bool> first;
    in property <bool> last;

    private property <bool> copied;

    function copy() {
        root.copied = PaletteLibrary.copy-color(root.swatch.hex);
    }

    horizontal-stretch: 1;
    background: root.swatch.color;
    border-top-left-radius: root.first ? Theme.radius-group : 0;
    border-top-right-radius: root.last ? Theme.radius-group : 0;
    z: fs.has-focus ? 1 : 0;
    accessible-role: button;
    accessible-label: "Copy " + root.swatch.hex;
    accessible-action-default => { root.copy(); }

    Rectangle {
        border-top-left-radius: parent.border-top-left-radius;
        border-top-right-radius: parent.border-top-right-radius;
        background: ta.pressed ? Theme.bg-pressed : ta.has-hover ? Theme.bg-hover : transparent;
        animate background { duration: Theme.dur-fast; easing: Theme.ease; }
    }

    VerticalLayout {
        padding: Theme.space-2;
        alignment: end;

        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-1;

            if root.copied: Image {
                source: AppIcons.check;
                colorize: root.swatch.light-ink ? Theme.swatch-ink-light : Theme.swatch-ink-dark;
                width: Theme.icon-size-small;
                height: Theme.icon-size-small;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.copied ? "Copied" : root.swatch.hex;
                color: root.swatch.light-ink ? Theme.swatch-ink-light : Theme.swatch-ink-dark;
                font-family: Theme.font-family-mono;
                font-size: Theme.size-footnote;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.copy(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.copy();
                return accept;
            }
            reject
        }
    }
    FocusRing { has-focus: fs.has-focus; radius: Theme.radius-nested; }

    Timer {
        interval: 1600ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
}

component PaletteCardView inherits Rectangle {
    in property <PaletteCard> card;

    border-radius: Theme.radius-group;
    background: Theme.bg-surface-raised;
    border-width: 1px;
    border-color: Theme.separator;

    VerticalLayout {
        HorizontalLayout {
            height: Theme.colors-card-art;

            for swatch[i] in root.card.swatches: SwatchButton {
                swatch: swatch;
                first: i == 0;
                last: i == root.card.swatches.length - 1;
            }
        }
        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-2;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-1;

            Text {
                text: root.card.name;
                color: Theme.text-primary;
                font-size: Theme.size-body;
                font-weight: Theme.weight-medium;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            CopyButton {
                text: "JSON";
                copy => { return PaletteLibrary.copy-json(root.card.index); }
            }
            CopyButton {
                text: "CSS";
                copy => { return PaletteLibrary.copy-css(root.card.index); }
            }
        }
    }
}

export component PaletteLibraryView inherits VerticalLayout {
    padding: Theme.space-6;
    padding-top: 0;
    spacing: Theme.space-4;

    HorizontalLayout {
        SearchField {
            placeholder: "Search palettes";
            edited(text) => { PaletteLibrary.search(text); }
        }
    }

    if PaletteLibrary.error != "": Notice {
        text: PaletteLibrary.error;
        tone: NoticeTone.error;
    }
    if PaletteLibrary.empty-text != "": Text {
        text: PaletteLibrary.empty-text;
        color: Theme.text-secondary;
        font-size: Theme.size-body;
    }

    ScrollView {
        vertical-stretch: 1;

        VerticalLayout {
            alignment: start;
            spacing: Theme.space-6;
            padding-right: Theme.space-3;

            for section in PaletteLibrary.sections: VerticalLayout {
                spacing: Theme.space-3;

                Text {
                    text: section.title;
                    color: Theme.text-primary;
                    font-size: Theme.size-headline;
                    font-weight: Theme.weight-semibold;
                }
                grid := Rectangle {
                    property <int> columns: max(1, floor((self.width + Theme.space-4) / (Theme.colors-card-min-width + Theme.space-4)));
                    property <length> card-width: (self.width - (self.columns - 1) * Theme.space-4) / self.columns;

                    height: ceil(section.cards.length / self.columns) * (Theme.colors-card-height + Theme.space-4) - Theme.space-4;

                    for card[i] in section.cards: PaletteCardView {
                        x: mod(i, grid.columns) * (grid.card-width + Theme.space-4);
                        y: floor(i / grid.columns) * (Theme.colors-card-height + Theme.space-4);
                        width: grid.card-width;
                        height: Theme.colors-card-height;
                        card: card;
                    }
                }
            }
        }
    }
}
