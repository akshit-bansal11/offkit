// Gradient Converter: a CSS, Tailwind or Bootstrap gradient in; its preview, a switch between
// linear, radial and conic, and the gradient as CSS, Tailwind and Bootstrap out. State lives in
// the `GradientConverter` global, driven by src/tools/gradient_converter.rs.

import { Theme } from "../theme.slint";
import { SegmentedControl } from "../components/fields.slint";
import { Notice, NoticeTone, Pane, PaneHeader, TextPane } from "../components/editor.slint";
import { OutputBlock, Swatch } from "colors-shared.slint";

export global GradientConverter {
    in-out property <string> input;
    in property <bool> valid;
    // The parsed kind: 0 linear, 1 radial, 2 conic.
    in property <int> kind;
    in property <int> stop-count;
    // "CSS", "Tailwind" or "Bootstrap".
    in property <string> detected;
    in property <image> preview;
    in property <string> css;
    in property <string> tailwind;
    in property <string> bootstrap;
    in property <string> error;

    callback edited();
    // Rewrites the input as another kind.
    callback convert(int);
    callback copy(string) -> bool;
}

export component GradientConverterView inherits VerticalLayout {
    padding: Theme.space-6;
    padding-top: 0;
    spacing: Theme.space-4;

    Pane {
        PaneHeader {
            title: "Gradient";

            if GradientConverter.valid: Text {
                text: "Read as " + GradientConverter.detected;
                color: Theme.text-secondary;
                font-size: Theme.size-callout;
                vertical-alignment: center;
            }
        }
        TextPane {
            label: "Gradient";
            vertical-stretch: 0;
            text <=> GradientConverter.input;
            placeholder: "Paste a gradient, e.g. linear-gradient(135deg, #2563EB, #EC4899), a Tailwind bg-gradient-to-r from-[…] to-[…] class, or a Bootstrap rule.";
            edited => { GradientConverter.edited(); }
        }
    }

    if GradientConverter.error != "": Notice {
        text: GradientConverter.error;
        tone: NoticeTone.error;
    }

    HorizontalLayout {
        spacing: Theme.space-6;
        vertical-stretch: 1;

        VerticalLayout {
            width: Theme.maker-side-width;
            spacing: Theme.space-3;
            alignment: start;

            Swatch {
                height: self.width * 9 / 16;

                if GradientConverter.valid: Image {
                    width: 100%;
                    height: 100%;
                    source: GradientConverter.preview;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: "Preview of " + GradientConverter.css;
                }
                if !GradientConverter.valid: Text {
                    text: "Paste a gradient to see it here.";
                    color: Theme.text-secondary;
                    font-size: Theme.size-callout;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: Theme.space-3;

                SegmentedControl {
                    label: "Gradient type";
                    options: ["Linear", "Radial", "Conic"];
                    enabled: GradientConverter.valid;
                    current-index: GradientConverter.kind;
                    selected(i) => { GradientConverter.convert(i); }
                }
                Rectangle { horizontal-stretch: 1; }
                if GradientConverter.valid: Text {
                    text: GradientConverter.stop-count + " stops";
                    color: Theme.text-secondary;
                    font-size: Theme.size-callout;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: Theme.space-4;
            alignment: start;
            horizontal-stretch: 1;

            OutputBlock {
                title: "CSS";
                value: GradientConverter.css;
                copy => { return GradientConverter.copy(GradientConverter.css); }
            }
            OutputBlock {
                title: "Tailwind";
                value: GradientConverter.tailwind;
                copy => { return GradientConverter.copy(GradientConverter.tailwind); }
            }
            OutputBlock {
                title: "Bootstrap 5";
                value: GradientConverter.bootstrap;
                copy => { return GradientConverter.copy(GradientConverter.bootstrap); }
            }
        }
    }
}
