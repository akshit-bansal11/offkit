// Audio Joiner view: an ordered list of tracks (buttons and Alt+Up / Alt+Down reorder them),
// with the format and Join in the inspector. All state lives in the `AudioJoiner` global, which
// Rust drives (src/tools/audio_joiner.rs); this file only lays it out.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AppIcons } from "../icons/icons.slint";
import { Button, ButtonKind, DropOutline, FocusRing, IconButton, ProgressBar, Select } from "../components/controls.slint";
import { DropZone, FileItem } from "../components/file-list.slint";
import { Inspector, InspectorRow, InspectorSection } from "../components/inspector.slint";
import { EmptyState } from "../components/empty-state.slint";
import { Notice, NoticeTone } from "../components/editor.slint";

export global AudioJoiner {
    in property <bool> ffmpeg-found: true;
    in property <bool> drop-hover;
    in property <[FileItem]> files;
    // "3 tracks · 04:12.5 in total"
    in property <string> summary;
    // Files are still being read.
    in property <bool> reading;
    in property <bool> can-join;
    // Why Join is unavailable, shown above it; empty when it isn't.
    in property <string> note;
    // What the last add couldn't read, one file per line.
    in property <string> error;
    // The row that takes the keyboard focus: set after a reorder so it can be repeated.
    in-out property <int> active: -1;

    in property <[string]> formats;
    in-out property <int> format-index;
    in property <bool> joining;
    in property <float> progress;
    // "Saved as joined_audio.mp3 · 4.1 MB", or what went wrong (`result-failed`).
    in property <string> result;
    in property <bool> result-failed;
    in property <bool> can-reveal;

    callback choose-files();
    callback remove(int);
    callback reorder(int, int); // index, places (-1 up, 1 down)
    callback clear();
    callback join();
    callback cancel-join();
    callback reveal();
    callback get-ffmpeg();
}

component TrackRow {
    in property <int> index;
    in property <int> count;
    in property <FileItem> item;
    private property <bool> wanted: AudioJoiner.active == root.index;

    height: Theme.audio-track-height;
    forward-focus: fs;
    accessible-role: list-item;
    accessible-label: (root.index + 1) + ". " + root.item.name;
    changed wanted => { if (root.wanted) { fs.focus(); } }

    Rectangle {
        border-radius: Theme.radius-group;
        background: Theme.bg-surface-raised;
        border-width: 1px;
        border-color: Theme.separator;
    }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.modifiers.alt && event.text == Key.UpArrow) {
                AudioJoiner.reorder(root.index, -1);
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.DownArrow) {
                AudioJoiner.reorder(root.index, 1);
                return accept;
            }
            if (event.text == Key.Delete) {
                AudioJoiner.remove(root.index);
                return accept;
            }
            reject
        }
        changed has-focus => { if (self.has-focus) { AudioJoiner.active = root.index; } }
    }

    FocusRing {
        has-focus: fs.has-focus;
        radius: Theme.radius-group;
    }

    HorizontalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;

        Text {
            text: root.index + 1;
            color: Theme.text-secondary;
            font-size: Theme.size-callout;
            width: Theme.audio-index-width;
            vertical-alignment: center;
            horizontal-alignment: right;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.item.name;
                color: Theme.text-primary;
                font-size: Theme.size-body;
                font-weight: Theme.weight-medium;
                overflow: elide;
                accessible-role: none;
            }
            Text {
                text: root.item.detail;
                color: Theme.text-secondary;
                font-size: Theme.size-footnote;
                overflow: elide;
                accessible-role: none;
            }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: AppIcons.arrow-up;
            label: "Move " + root.item.name + " up";
            enabled: root.index > 0;
            clicked => { AudioJoiner.reorder(root.index, -1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: AppIcons.arrow-down;
            label: "Move " + root.item.name + " down";
            enabled: root.index < root.count - 1;
            clicked => { AudioJoiner.reorder(root.index, 1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: AppIcons.close;
            label: "Remove " + root.item.name;
            clicked => { AudioJoiner.remove(root.index); }
        }
    }
}

component Settings inherits Inspector {
    action-text: "Join and Save…";
    stop-text: "Cancel";
    can-run: AudioJoiner.can-join;
    running: AudioJoiner.joining;
    note: AudioJoiner.note;
    run => { AudioJoiner.join(); }
    stop => { AudioJoiner.cancel-join(); }

    InspectorSection {
        title: "Format";
        footnote: "Save… suggests a name in this format; typing another extension (.wav, .flac, …) picks that format instead. Every track is joined as 48 kHz stereo.";

        InspectorRow {
            label: "Save as";
            first: true;

            Select {
                label: "Output format";
                options: AudioJoiner.formats;
                current-index <=> AudioJoiner.format-index;
            }
        }
    }

    if AudioJoiner.joining: InspectorSection {
        title: "Joining";

        VerticalLayout {
            padding: Theme.space-3;
            spacing: Theme.space-2;

            Text {
                text: "Joining · " + round(AudioJoiner.progress * 100) + "%";
                color: Theme.text-secondary;
                font-size: Theme.size-footnote;
            }
            ProgressBar { progress: AudioJoiner.progress; }
        }
    }

    if !AudioJoiner.joining && AudioJoiner.result != "": InspectorSection {
        title: "Result";

        HorizontalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-2;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            spacing: Theme.space-2;

            Notice {
                text: AudioJoiner.result;
                tone: AudioJoiner.result-failed ? NoticeTone.error : NoticeTone.info;
            }
            if AudioJoiner.can-reveal: IconButton {
                icon: AppIcons.folder;
                label: "Show in folder";
                clicked => { AudioJoiner.reveal(); }
            }
        }
    }
}

export component AudioJoinerView inherits VerticalLayout {
    if !AudioJoiner.ffmpeg-found: EmptyState {
        icon: AppIcons.alert;
        title: "FFmpeg wasn't found";
        message: "Audio Joiner runs FFmpeg on your computer. Install it so that ffmpeg and ffprobe are on your PATH, or place both next to Open Tools, then restart the app.";
        action-text: "Get FFmpeg";
        action => { AudioJoiner.get-ffmpeg(); }
    }

    if AudioJoiner.ffmpeg-found: HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: Theme.space-6;
                padding-top: 0;
                spacing: Theme.space-4;

                if AudioJoiner.files.length == 0: DropZone {
                    vertical-stretch: 1;
                    drop-hover: AudioJoiner.drop-hover;
                    icon: AppIcons.list-music;
                    title: AudioJoiner.reading ? "Reading…" : "Drop audio files here";
                    hint: "Add two or more: MP3, WAV, FLAC, M4A, OGG, Opus and most other formats. They are joined in list order.";
                    choose => { AudioJoiner.choose-files(); }
                }

                if AudioJoiner.files.length > 0: HorizontalLayout {
                    spacing: Theme.space-2;

                    Text {
                        text: AudioJoiner.reading ? AudioJoiner.summary + " · reading…" : AudioJoiner.summary;
                        color: Theme.text-secondary;
                        font-size: Theme.size-callout;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Button {
                        text: "Add Files…";
                        kind: ButtonKind.plain;
                        clicked => { AudioJoiner.choose-files(); }
                    }
                    Button {
                        text: "Clear";
                        kind: ButtonKind.plain;
                        enabled: !AudioJoiner.joining;
                        clicked => { AudioJoiner.clear(); }
                    }
                }
                if AudioJoiner.files.length > 0: Rectangle {
                    vertical-stretch: 1;

                    DropOutline {
                        border-radius: Theme.radius-surface;
                        background: AudioJoiner.drop-hover ? Theme.drop-fill : transparent;
                        drop-hover: AudioJoiner.drop-hover;
                        resting: transparent;
                    }
                    ScrollView {
                        VerticalLayout {
                            spacing: Theme.space-2;
                            padding: Theme.space-2;
                            alignment: start;

                            for file[i] in AudioJoiner.files: TrackRow {
                                index: i;
                                count: AudioJoiner.files.length;
                                item: file;
                            }
                        }
                    }
                }

                if AudioJoiner.error != "": Notice {
                    text: AudioJoiner.error;
                    tone: NoticeTone.error;
                }
            }
        }

        Settings {
            width: Theme.inspector-width;
        }
    }
}
