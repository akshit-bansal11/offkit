<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Offkit third-party notices</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; }
  pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; border-radius: 6px; font-size: 12px; }
  ul.used { columns: 2; }
</style>
</head>
<body>
<h1>Offkit third-party notices</h1>
<p>Offkit is built on the open-source crates below. PDFium's own licence ships beside this file as pdfium-LICENSE and pdfium-licenses/.</p>
<h2>Licences</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<h3>Used by</h3>
<ul class="used">
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
